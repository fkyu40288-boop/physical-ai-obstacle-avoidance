<?xml version="1.0"?>
<sdf version="1.9">
  <world name="ai_obstacle_world">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <direction>-0.4 0.2 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
    </light>

    <model name="ground" >
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>30 10</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>30 10</size></plane></geometry>
          <material><ambient>0.65 0.68 0.7 1</ambient><diffuse>0.65 0.68 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="red_obstacle">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
        </collision>
        <visual name="obstacle_visual">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
          <material><ambient>1 0.03 0.03 1</ambient><diffuse>1 0.03 0.03 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="red_obstacle_2">
      <static>true</static>
      <pose>6.0 0.8 0.5 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
        </collision>
        <visual name="obstacle_visual">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
          <material>
            <ambient>1 0.03 0.03 1</ambient>
            <diffuse>1 0.03 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="red_obstacle_3">
      <static>true</static>
      <pose>9.0 -0.8 0.5 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
        </collision>
        <visual name="obstacle_visual">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
          <material>
            <ambient>1 0.03 0.03 1</ambient>
            <diffuse>1 0.03 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="red_obstacle_4">
      <static>true</static>
      <pose>12.0 0.8 0.5 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
        </collision>
        <visual name="obstacle_visual">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
          <material>
            <ambient>1 0.03 0.03 1</ambient>
            <diffuse>1 0.03 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="red_obstacle_5">
      <static>true</static>
      <pose>15.0 -0.8 0.5 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
        </collision>
        <visual name="obstacle_visual">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
          <material>
            <ambient>1 0.03 0.03 1</ambient>
            <diffuse>1 0.03 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="red_obstacle_6">
      <static>true</static>
      <pose>18.0 0.8 0.5 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
        </collision>
        <visual name="obstacle_visual">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
          <material>
            <ambient>1 0.03 0.03 1</ambient>
            <diffuse>1 0.03 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="red_obstacle_7">
      <static>true</static>
      <pose>21.0 -0.8 0.5 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
        </collision>
        <visual name="obstacle_visual">
          <geometry><box><size>0.5 1.2 1</size></box></geometry>
          <material>
            <ambient>1 0.03 0.03 1</ambient>
            <diffuse>1 0.03 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="vehicle">
      <pose>0 0 0.18 0 0 0</pose>
      <link name="chassis">
        <inertial>
          <mass>5</mass>
          <inertia><ixx>0.15</ixx><iyy>0.3</iyy><izz>0.35</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="chassis_collision">
          <geometry><box><size>0.6 0.4 0.16</size></box></geometry>
        </collision>
        <visual name="chassis_visual">
          <geometry><box><size>0.6 0.4 0.16</size></box></geometry>
          <material><ambient>0.05 0.25 0.9 1</ambient><diffuse>0.05 0.25 0.9 1</diffuse></material>
        </visual>
        <sensor name="front_lidar" type="gpu_lidar">
          <pose>0.3 0 0.08 0 0 0</pose>
          <topic>/lidar</topic>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>181</samples>
                <resolution>1</resolution>
                <min_angle>-1.5708</min_angle>
                <max_angle>1.5708</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0 0.23 -0.08 -1.5708 0 0</pose>
        <inertial><mass>0.4</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="left_collision"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="left_visual"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.23 -0.08 -1.5708 0 0</pose>
        <inertial><mass>0.4</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="right_collision"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="right_visual"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent><child>left_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent><child>right_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.46</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <topic>/model/vehicle/cmd_vel</topic>
        <max_linear_velocity>0.35</max_linear_velocity>
        <max_angular_velocity>0.8</max_angular_velocity>
      </plugin>
    </model>
  </world>
</sdf>
